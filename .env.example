# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file — .gitignore already excludes it.

# ---------------------------------------------------------------------------
# PostgreSQL (used by docker-compose.yml and by the backend's connection string)
# ---------------------------------------------------------------------------
POSTGRES_DB=realtest
POSTGRES_USER=realtest
POSTGRES_PASSWORD=realtest_dev_password
POSTGRES_PORT=5436

# Full connection string the backend uses. When running the backend outside Docker,
# "Host" should be localhost; when running the backend itself inside docker-compose,
# set it to the "postgres" service name instead. The port matches POSTGRES_PORT above
# (5436 by default, to avoid colliding with a locally installed PostgreSQL on 5432).
ConnectionStrings__Postgres=Host=localhost;Port=5436;Database=realtest;Username=realtest;Password=realtest_dev_password

# ---------------------------------------------------------------------------
# JWT authentication
# ---------------------------------------------------------------------------
# ValidIssuer / ValidAudience the API issues and validates access tokens against.
Jwt__Issuer=realtest-api-dev
Jwt__Audience=realtest-client-dev
# Symmetric signing key — must be at least 32 characters. Generate a real random
# value for anything beyond local development, e.g.: openssl rand -base64 48
Jwt__SigningKey=dev-only-signing-key-change-me-please-32chars-min
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=7

# ---------------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------------
Frontend__Url=http://localhost:3000
BACKEND_URL=http://localhost:5205
NEXT_PUBLIC_API_URL=http://localhost:5205

# ---------------------------------------------------------------------------
# Email provider (placeholder — the foundation logs instead of sending real email)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=logging
EMAIL_FROM_ADDRESS=no-reply@realtest.app
EMAIL_API_KEY=
